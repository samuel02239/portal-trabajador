# =====================================================================
# Plantilla de configuración (sin valores reales). Este archivo SÍ va al repositorio.
#   - Servidor en la nube: cada variable de la sección "Backend" se escribe en el panel del servicio
#     (Render > Environment). Ver DESPLIEGUE.md.
#   - Pruebas en el PC: copia la sección "Backend" a backend/.env (ese archivo NUNCA se sube).
#   - Programa de escritorio: sección "Escritorio" en escritorio/.env (solo valores públicos).
# =====================================================================

# --- Backend --------------------------------------------------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Una o varias llaves de OpenRouter separadas por coma. Si una se queda sin saldo, es inválida o tiene
# límite, el servidor pasa sola a la siguiente (y la vuelve a intentar más tarde).
OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
# Los modelos van en backend/providers.json. Si ese archivo no existe se usa esta lista:
OPENROUTER_MODELS=

# Wompi (comercios.wompi.co > Desarrolladores). En pruebas empiezan por pub_test_, prv_test_, test_events_,
# test_integrity_; en producción por pub_prod_, prv_prod_, prod_events_, prod_integrity_.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_REDIRECT_URL=

# Versión mínima del programa de escritorio que acepta el servidor y enlace para descargar la nueva
VERSION_MINIMA_ESCRITORIO=1.1.0
URL_DESCARGA_ESCRITORIO=

# Solo en el PC (en el servidor no hace falta): ruta de soffice.exe. Vacío = se busca solo / se usa Word.
LIBREOFFICE_PATH=

# --- Escritorio (escritorio/.env) --------------------------------------------
# remoto = usa el servidor de API_BASE_URL (así va el instalador que se reparte)
# integrado = enciende el backend dentro del programa (solo para pruebas en tu PC)
MODO_BACKEND=remoto
API_BASE_URL=https://TU-SERVICIO.onrender.com
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
