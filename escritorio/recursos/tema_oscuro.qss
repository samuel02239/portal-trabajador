
QWidget { color: #E6EBF2; font-family: "Segoe UI"; font-size: 11pt; }
QMainWindow, QDialog, QWidget#fondo, QStackedWidget#paginas { background: #0B111A; }
QScrollArea { background: transparent; border: none; }
QWidget#contenidoScroll { background: transparent; }

/* ---------- Tarjetas y contenedores ---------- */
QFrame#tarjeta { background: #121A26; border: 1px solid #223044; border-radius: 8px; }
QFrame#indicador { background: #121A26; border: 1px solid #223044; border-radius: 8px; }
QFrame#barraSuperior { background: #121A26; border-bottom: 1px solid #223044; }
QFrame#separador { background: #223044; max-height: 1px; min-height: 1px; border: none; }
QFrame#chip { background: #13303D; border: 1px solid #223044; border-radius: 15px; }
QFrame#chip QLabel { color: #86CFDF; font-weight: 600; background: transparent; }
QLabel#avatar { background: #12708A; color: #FFFFFF; border-radius: 17px; font-weight: 700;
    font-size: 10pt; }

/* ---------- Barra lateral ---------- */
QFrame#barraLateral { background: #070D15; }
QFrame#barraLateral QLabel { color: #D3DCE6; background: transparent; }
QFrame#barraLateral QLabel[rol="lateralSec"] { color: #8D9DB0; font-size: 9pt; letter-spacing: 1px; }
QFrame#barraLateral QLabel[rol="lateralMarca"] { font-family: "Georgia"; font-size: 14pt; color: #FFFFFF; }
QFrame#barraLateral QLabel[rol="lateralDato"] { color: #8D9DB0; }
QFrame#marcaIcono { background: #12708A; border-radius: 6px; }
QPushButton#navBoton { color: #D3DCE6; background: transparent; border: none; border-left: 3px solid transparent;
    border-radius: 0; padding: 10px 14px; text-align: left; font-size: 11pt; }
QPushButton#navBoton:hover { background: #101B29; color: #FFFFFF; }
QPushButton#navBoton:checked { background: #16283B; color: #FFFFFF; font-weight: 600;
    border-left: 3px solid #5FC3D6; }
QPushButton#navBoton:focus { background: #101B29; border-left: 3px solid #5FC3D6; }
QFrame#usuarioLateral { background: #101B29; border-radius: 6px; }

/* ---------- Panel de marca (inicio de sesión) ---------- */
QWidget#ladoFormulario, QWidget#vistaFormulario { background: #121A26; }
QFrame#formulario { background: transparent; border: none; }
QFrame#panelMarca { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #070D15, stop:1 #0E3446); }
QFrame#panelMarca QLabel { color: #D3DCE6; background: transparent; }
QFrame#panelMarca QLabel[rol="marcaGrande"] { font-family: "Georgia"; font-size: 28pt; color: #FFFFFF; }
QFrame#panelMarca QLabel[rol="marcaTexto"] { font-size: 12pt; color: #D3DCE6; }
QFrame#panelMarca QLabel[rol="marcaPie"] { font-size: 9pt; color: #8D9DB0; }

/* ---------- Tipografía ---------- */
QLabel[rol="titulo"] { font-family: "Georgia"; font-size: 21pt; color: #E6EBF2; }
QLabel[rol="subtitulo"] { font-family: "Georgia"; font-size: 14pt; color: #E6EBF2; }
QLabel[rol="marca"] { color: #9EACBC; }
QLabel[rol="migas"] { color: #9EACBC; }
QLabel[rol="migasActual"] { color: #E6EBF2; font-weight: 600; }
QLabel[rol="seccion"] { font-weight: 600; }
QLabel[rol="secundario"] { color: #9EACBC; }
QLabel[rol="error"] { color: #F59A90; }
QLabel[rol="cita"] { color: #9EACBC; font-style: italic; }
QLabel[rol="grande"] { font-size: 16pt; font-weight: 600; color: #86CFDF; }
QLabel[rol="kpiValor"] { font-size: 22pt; font-weight: 600; color: #E6EBF2; }
QLabel[rol="kpiEtiqueta"] { color: #9EACBC; }
QLabel[rol="kpiNota"] { color: #9EACBC; }
QLabel[rol="precio"] { font-size: 20pt; font-weight: 600; color: #E6EBF2; }
QLabel a { color: #86CFDF; }

/* ---------- Botones ---------- */
QPushButton { background: #121A26; color: #E6EBF2; border: 1px solid #33445C;
    border-radius: 6px; padding: 8px 16px; min-height: 22px; font-weight: 600; }
QPushButton:hover { background: #1A2536; border-color: #66768C; }
QPushButton:pressed { background: #223044; }
QPushButton:focus { border: 2px solid #86CFDF; }
QPushButton:disabled { color: #6A788C; border-color: #223044; background: #162030; }
QPushButton[variante="primario"] { background: #12708A; color: #FFFFFF; border: 1px solid #12708A; }
QPushButton[variante="primario"]:hover { background: #158099; border-color: #158099; }
QPushButton[variante="primario"]:focus { border: 2px solid #86CFDF; }
QPushButton[variante="primario"]:disabled { background: #223044; color: #6A788C; border-color: #223044; }
QPushButton[variante="peligro"] { background: #121A26; color: #F59A90; border: 1px solid #F59A90; }
QPushButton[variante="peligro"]:hover { background: #3A1612; }
QPushButton[variante="enlace"] { background: transparent; border: none; color: #86CFDF; padding: 2px 4px;
    font-weight: 600; min-height: 0; }
QPushButton[variante="enlace"]:hover { text-decoration: underline; }
QPushButton[variante="enlace"]:focus { border: 1px dashed #86CFDF; }
QPushButton[variante="icono"] { padding: 6px; min-width: 22px; background: transparent; border: 1px solid transparent; }
QPushButton[variante="icono"]:hover { background: #1A2536; border-color: #33445C; }
QPushButton[segmento="true"] { border-radius: 0; padding: 9px 12px; background: #162030;
    color: #9EACBC; }
QPushButton[segmento="true"]:checked { background: #121A26; color: #86CFDF;
    border-bottom: 2px solid #12708A; }

/* ---------- Campos ---------- */
QLineEdit, QPlainTextEdit, QTextEdit, QDateEdit, QComboBox, QSpinBox { background: #0E1520; color: #E6EBF2;
    border: 1px solid #66768C; border-radius: 6px; padding: 7px 10px; font-size: 11pt;
    selection-background-color: #12708A; selection-color: #FFFFFF; }
QLineEdit:hover, QPlainTextEdit:hover, QDateEdit:hover, QComboBox:hover { border-color: #9EACBC; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QDateEdit:focus, QComboBox:focus { border: 2px solid #86CFDF; }
QLineEdit[error="true"], QPlainTextEdit[error="true"], QDateEdit[error="true"], QComboBox[error="true"] { border: 2px solid #F59A90; }
QLineEdit:read-only { background: #162030; color: #9EACBC; border-color: #33445C; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView { background: #121A26; color: #E6EBF2; selection-background-color: #13303D;
    selection-color: #E6EBF2; border: 1px solid #33445C; outline: 0; padding: 4px; }
QCalendarWidget QWidget { background: #121A26; color: #E6EBF2; }
QListWidget { background: #0E1520; border: 1px solid #33445C; border-radius: 6px; padding: 4px; }
QListWidget::item { padding: 4px; border-radius: 4px; }
QListWidget::item:selected { background: #13303D; color: #E6EBF2; }

/* ---------- Avisos ---------- */
QFrame#aviso { border-radius: 6px; border: 1px solid; border-left: 4px solid; }
QFrame#aviso[nivel="info"] { background: #0F2833; border-color: #223044; border-left-color: #86CFDF; }
QFrame#aviso[nivel="exito"] { background: #0F2A1C; border-color: #223044; border-left-color: #6FD3A0; }
QFrame#aviso[nivel="advertencia"] { background: #33250D; border-color: #223044; border-left-color: #F2B85B; }
QFrame#aviso[nivel="error"] { background: #3A1612; border-color: #223044; border-left-color: #F59A90; }
QFrame#aviso QLabel { background: transparent; color: #E6EBF2; }

/* ---------- Insignias ---------- */
QLabel#insignia { border-radius: 10px; padding: 2px 10px; font-weight: 600; }
QLabel#insignia[estado="confirmada"], QLabel#insignia[estado="alta"] { background: #0F2A1C; color: #6FD3A0; }
QLabel#insignia[estado="propuesta"], QLabel#insignia[estado="media"] { background: #33250D; color: #F2B85B; }
QLabel#insignia[estado="sin_obligacion"], QLabel#insignia[estado="baja"] { background: #3A1612; color: #F59A90; }
QLabel#insignia[estado="neutra"] { background: #162030; color: #9EACBC; border: 1px solid #223044; }
QLabel#insignia[estado="marca"] { background: #13303D; color: #86CFDF; }

/* ---------- Medidores ---------- */
QProgressBar { background: #1B3140; border: none; border-radius: 3px; max-height: 6px; min-height: 6px; }
QProgressBar::chunk { background: #4FB3C8; border-radius: 3px; }

/* ---------- Zona de archivo ---------- */
QFrame#zonaArchivo { background: #162030; border: 2px dashed #66768C; border-radius: 8px; }
QFrame#zonaArchivo:hover { border-color: #86CFDF; }
QFrame#zonaArchivo[activa="true"] { border-color: #86CFDF; background: #13303D; }
QFrame#zonaArchivo:focus { border: 2px solid #86CFDF; }

QFrame#filaActividad { border: none; border-top: 1px solid #223044; background: transparent; }

/* ---------- Acordeón ---------- */
QToolButton#cabeceraSeccion { background: transparent; border: none; padding: 12px 14px; text-align: left;
    font-weight: 600; font-size: 11pt; color: #E6EBF2; }
QToolButton#cabeceraSeccion:hover { color: #86CFDF; }
QToolButton#cabeceraSeccion:focus { border: 2px solid #86CFDF; border-radius: 6px; }

/* ---------- Tablas, menús y otros ---------- */
QTableWidget { background: #121A26; gridline-color: #223044; border: 1px solid #223044;
    border-radius: 6px; alternate-background-color: #162030; }
QHeaderView::section { background: #162030; color: #9EACBC; padding: 8px; border: none;
    border-bottom: 1px solid #223044; font-weight: 600; }
QToolTip { background: #E6EBF2; color: #121A26; border: none; padding: 6px 8px; }
QCheckBox, QRadioButton { spacing: 8px; }
QMenu { background: #121A26; border: 1px solid #33445C; padding: 4px; }
QMenu::item { padding: 7px 18px; border-radius: 4px; }
QMenu::item:selected { background: #13303D; color: #E6EBF2; }
QMenu::separator { height: 1px; background: #223044; margin: 4px 8px; }

QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: #33445C; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #66768C; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: #33445C; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
